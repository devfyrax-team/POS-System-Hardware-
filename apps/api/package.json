{
  "name": "@pos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "migrate": "ts-node -r tsconfig-paths/register src/db/migrate-cli.ts",
    "integrity": "ts-node -r tsconfig-paths/register src/db/integrity-cli.ts",
    "worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "load": "ts-node -r tsconfig-paths/register scripts/load-test.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register scripts/seed-demo.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.2",
    "@node-rs/argon2": "^2.0.0",
    "@pos/contracts": "*",
    "@pos/money": "*",
    "cookie-parser": "^1.4.6",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  }
}
